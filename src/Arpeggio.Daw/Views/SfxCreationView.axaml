<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arpeggio.Daw.Views.SfxCreationView">
  <StackPanel Margin="12" Spacing="10">
    <TextBlock Text="SFX を作る" FontSize="18" FontWeight="SemiBold" />
    <ComboBox x:Name="PresetSelector" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="PresetDescription" TextWrapping="Wrap" />
    <TextBlock Text="保存先" />
    <TextBox x:Name="DestinationInput" TextWrapping="Wrap" />
    <TextBlock Text="現在のチップで作成します。未保存の編集は保存して切り替えます。" TextWrapping="Wrap" Opacity="0.65" />
    <Button x:Name="CreateButton" Content="作成して開く" HorizontalAlignment="Stretch" />
  </StackPanel>
</UserControl>
