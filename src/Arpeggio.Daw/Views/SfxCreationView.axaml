<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arpeggio.Daw.Views.SfxCreationView" Background="{StaticResource Arpeggio.Panel}">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="SFX を作る" Classes="heading" />
    <ComboBox x:Name="PresetSelector" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="PresetDescription" TextWrapping="Wrap" />
    <TextBlock Text="保存先" />
    <TextBox x:Name="DestinationInput" TextWrapping="Wrap" />
    <TextBlock Text="現在のチップで作成します。未保存の編集は保存して切り替えます。" TextWrapping="Wrap" Classes="secondary" />
    <Button x:Name="CreateButton" ContentTemplate="{StaticResource Arpeggio.Content.FolderOpen}" Classes="primary" Content="作成して開く" HorizontalAlignment="Stretch" ToolTip.Tip="作成して開く" />
  </StackPanel>
</UserControl>
