<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Arpeggio.Daw.Views.TransportView">
  <StackPanel Orientation="Horizontal" Margin="12,8" Spacing="8">
    <Button x:Name="PlayButton" ContentTemplate="{StaticResource Arpeggio.Content.Play}" Classes="primary" Content="▶ 再生" MinWidth="90" ToolTip.Tip="{ReflectionBinding Content, RelativeSource={RelativeSource Self}}" />
    <Button x:Name="StopButton" ContentTemplate="{StaticResource Arpeggio.Content.Stop}" Content="■ 停止" ToolTip.Tip="■ 停止" />
    <Button x:Name="LoopButton" ContentTemplate="{StaticResource Arpeggio.Content.Loop}" Content="ループ OFF" MinWidth="100" ToolTip.Tip="{ReflectionBinding Content, RelativeSource={RelativeSource Self}}" />
    <TextBlock Text="BPM" VerticalAlignment="Center" />
    <TextBox x:Name="TempoInput" Classes="numeric" Width="72" />
    <TextBlock Text="長さ (tick)" VerticalAlignment="Center" />
    <TextBox x:Name="LengthInput" Classes="numeric" Width="90" />
    <TextBlock x:Name="PositionLabel" Classes="position" VerticalAlignment="Center" Margin="16,0" />
    <TextBlock Text="Space 再生/停止 · Ctrl+S 保存" Foreground="{StaticResource Arpeggio.TextSecondary}" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
