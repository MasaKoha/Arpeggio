<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presenters="using:Arpeggio.Daw.Presenters"
             x:Class="Arpeggio.Daw.Views.SnesDspView">
  <!-- 右ペインは縦に長くなりやすいため、ADSR は 1 行 4 欄、フラグは 1 行 2 つに詰める（ラベルの完全名はツールチップ） -->
  <StackPanel Spacing="{StaticResource Arpeggio.Space.Medium}">
    <TextBlock Text="ADSR レジスタ（空欄で秒指定）" Classes="heading" />
    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto"
          ColumnSpacing="{StaticResource Arpeggio.Space.Small}" RowSpacing="{StaticResource Arpeggio.Space.Small}">
      <TextBlock Text="A 0〜15" Classes="secondary" ToolTip.Tip="Attack rate（0〜15）" />
      <TextBlock Grid.Column="1" Text="D 0〜7" Classes="secondary" ToolTip.Tip="Decay rate（0〜7）" />
      <TextBlock Grid.Column="2" Text="SL 0〜7" Classes="secondary" ToolTip.Tip="Sustain level（0〜7）" />
      <TextBlock Grid.Column="3" Text="SR 0〜31" Classes="secondary" ToolTip.Tip="Sustain rate（0〜31）" />
      <TextBox Grid.Row="1" x:Name="AttackInput" Classes="numeric" ToolTip.Tip="Attack rate（0〜15）" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="DecayInput" Classes="numeric" ToolTip.Tip="Decay rate（0〜7）" />
      <TextBox Grid.Row="1" Grid.Column="2" x:Name="SustainLevelInput" Classes="numeric" ToolTip.Tip="Sustain level（0〜7）" />
      <TextBox Grid.Row="1" Grid.Column="3" x:Name="SustainRateInput" Classes="numeric" ToolTip.Tip="Sustain rate（0〜31）" />
    </Grid>
    <TextBlock x:Name="RegisterError" IsVisible="False" Foreground="{StaticResource Arpeggio.Danger}"
               Text="各欄を範囲内の整数で入力してください。" TextWrapping="Wrap" />
    <TextBlock Text="DSP" Classes="heading" />
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Arpeggio.Space.Section}">
      <Border x:Name="PitchModulationHint" Background="{StaticResource Arpeggio.Transparent}">
        <CheckBox x:Name="PitchModulationInput" Content="ピッチ変調" ToolTip.Tip="前のボイスの出力でピッチを揺らす（ボイス 0 は不可）" />
      </Border>
      <CheckBox x:Name="NoiseEnabledInput" Content="ノイズ" ToolTip.Tip="サンプルの代わりに 15 bit LFSR を鳴らす" />
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Arpeggio.Space.Medium}">
      <TextBlock Text="ノイズ速度" Classes="secondary" VerticalAlignment="Center" ToolTip.Tip="NoiseRate（0〜31）。大きいほど高域寄り" />
      <Slider Grid.Column="1" x:Name="NoiseRateInput" Minimum="0" Maximum="{x:Static presenters:SnesInstrumentInput.MaximumRateSliderValue}"
              TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
      <TextBlock x:Name="NoiseRateValue" Grid.Column="2" Classes="numeric" VerticalAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
