<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Arpeggio.Daw.Views"
        xmlns:pianoRoll="using:Arpeggio.Daw.Views.PianoRoll"
        xmlns:instrument="using:Arpeggio.Daw.Views.Instrument"
        xmlns:sfx="using:Arpeggio.Daw.Views.Sfx"
        xmlns:brief="using:Arpeggio.Daw.Views.Brief"
        xmlns:transport="using:Arpeggio.Daw.Views.Transport"
        xmlns:export="using:Arpeggio.Daw.Views.Export"
        xmlns:midi="using:Arpeggio.Daw.Views.Midi"
        xmlns:analysis="using:Arpeggio.Daw.Views.Analysis"
        x:Class="Arpeggio.Daw.Views.MainWindow" x:Name="DawWindow" Title="Arpeggio" Width="1380" Height="820" MinWidth="1050" MinHeight="560" Background="{StaticResource Arpeggio.Background}"
        Icon="/Assets/arpeggio.png">
  <Grid RowDefinitions="44,*,Auto,Auto,Auto">
    <Border Grid.Row="0" Background="{StaticResource Arpeggio.Panel}" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock FontWeight="Bold" Foreground="{StaticResource Arpeggio.Accent}" VerticalAlignment="Center">
          <InlineUIContainer><PathIcon Data="{StaticResource Icon.App}" Width="20" Height="20" Margin="0,0,8,0" /></InlineUIContainer><Run Text="ARPEGGIO   /   CHIPTUNE STUDIO" />
        </TextBlock>
        <TextBlock x:Name="SnapLabel" Grid.Column="1" Text="Alt スナップ解除 · Ctrl+ホイール ズーム" Foreground="{StaticResource Arpeggio.TextSecondary}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="210,*,340">
      <ScrollViewer x:Name="TracksScroll" Grid.Column="0" HorizontalScrollBarVisibility="Disabled"><views:TrackListView x:Name="Tracks" /></ScrollViewer>
      <Grid Grid.Column="1" ColumnDefinitions="60,*" RowDefinitions="Auto,30,*,Auto" ClipToBounds="True">
        <pianoRoll:PianoRollToolbarView x:Name="PianoRollToolbar" Grid.ColumnSpan="2" Grid.Row="0" />
        <pianoRoll:VelocityLaneControl x:Name="VelocityLane" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Height="{StaticResource Arpeggio.VelocityLane.Height}" />
        <TextBlock Grid.Row="3" Text="音量" Margin="{StaticResource Arpeggio.Margin.Small}" Foreground="{StaticResource Arpeggio.TextSecondary}" />
        <Border Grid.Row="1" Background="{StaticResource Arpeggio.Panel}"><TextBlock Text="NOTE" FontSize="11" Margin="4" /></Border>
        <pianoRoll:TimeRulerControl x:Name="Ruler" Grid.Row="1" Grid.Column="1" />
        <pianoRoll:KeyboardStripControl x:Name="Keyboard" Grid.Row="2" />
        <ScrollViewer x:Name="RollScroll" Grid.Row="2" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <pianoRoll:PianoRollControl x:Name="PianoRoll" />
        </ScrollViewer>
      </Grid>
      <TabControl x:Name="EditorTabs" Grid.Column="2">
        <TabItem x:Name="EditTab" Header="編集">
          <ScrollViewer x:Name="EditScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <pianoRoll:NotePanelView x:Name="Notes" />
              <instrument:InstrumentPanelView x:Name="Instruments" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="AnalysisTab" Header="解析"><analysis:AnalysisView x:Name="Analysis" /></TabItem>
        <TabItem x:Name="SfxTab" Header="SFX"><sfx:SfxCreationView x:Name="SfxCreation" /></TabItem>
        <TabItem x:Name="BriefTab" Header="指示書"><brief:BriefCreationView x:Name="BriefCreation" /></TabItem>
        <TabItem x:Name="ExportTab" Header="書き出し"><export:ChipExportView x:Name="ChipExport" /></TabItem>
        <TabItem x:Name="MidiTab" Header="MIDI"><midi:MidiImportView x:Name="MidiImport" /></TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Arpeggio.Panel}">
      <ScrollViewer x:Name="TransportScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="*,Auto">
        <transport:TransportView x:Name="Transport" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8">
          <Button x:Name="EchoButton" ContentTemplate="{StaticResource Arpeggio.Content.Echo}" Content="エコー"
                  IsVisible="False" ToolTip.Tip="ソング全体の SNES エコーを設定">
            <Button.Flyout>
              <Flyout><instrument:SnesEchoView x:Name="SnesEchoPanel" /></Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="SfxButton" ContentTemplate="{StaticResource Arpeggio.Content.Sfx}" Content="SFX を作る" ToolTip.Tip="SFX を作る" />
          <Button x:Name="MidiImportButton" Content="MIDI を取り込む" />
          <Button x:Name="ExportButton" ContentTemplate="{StaticResource Arpeggio.Content.Export}" Content="書き出し" ToolTip.Tip="Ctrl+E · WAV / OGG / NSF / VGM" />
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="12,8">
      <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
        <Button x:Name="RevealExportButton" ContentTemplate="{StaticResource Arpeggio.Content.FolderOpen}" Content="フォルダを開く" IsVisible="False" ToolTip.Tip="最後に書き出したファイルを Finder / Explorer で表示" />
        <Button x:Name="WarningsButton" ContentTemplate="{StaticResource Arpeggio.Content.Warning}" Content="警告 0" ToolTip.Tip="{ReflectionBinding Content, RelativeSource={RelativeSource Self}}" />
      </StackPanel>
    </Grid>
    <TextBox x:Name="WarningsText" Grid.Row="4" IsVisible="False" IsReadOnly="True" AcceptsReturn="True" MaxHeight="180" TextWrapping="Wrap" />
  </Grid>
</Window>
