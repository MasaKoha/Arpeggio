<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Arpeggio.Daw.Views"
        x:Class="Arpeggio.Daw.Views.MainWindow" Title="Arpeggio" Width="1380" Height="820" MinWidth="1050" MinHeight="560" Background="#151B24">
  <Grid RowDefinitions="44,*,Auto,Auto,Auto">
    <Border Grid.Row="0" Background="#202B38" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="ARPEGGIO   /   CHIPTUNE STUDIO" FontWeight="Bold" Foreground="#69C7AD" />
        <TextBlock Grid.Column="1" Text="1/16 GRID · Alt スナップ解除 · Ctrl+ホイール ズーム" Foreground="#94A8BA" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="210,*,300">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled"><views:TrackListView x:Name="Tracks" /></ScrollViewer>
      <Grid Grid.Column="1" ColumnDefinitions="60,*" RowDefinitions="30,*" ClipToBounds="True">
        <Border Background="#202B38"><TextBlock Text="NOTE" FontSize="10" Margin="6" /></Border>
        <views:TimeRulerControl x:Name="Ruler" Grid.Column="1" />
        <views:KeyboardStripControl x:Name="Keyboard" Grid.Row="1" />
        <ScrollViewer x:Name="RollScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <views:PianoRollControl x:Name="PianoRoll" />
        </ScrollViewer>
      </Grid>
      <views:InstrumentPanelView x:Name="Instruments" Grid.Column="2" />
    </Grid>
    <Border Grid.Row="2" Background="#202B38"><views:TransportView x:Name="Transport" /></Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="12,6">
      <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button x:Name="WarningsButton" Grid.Column="1" Content="警告 0" Margin="10,0,0,0" />
    </Grid>
    <TextBox x:Name="WarningsText" Grid.Row="4" IsVisible="False" IsReadOnly="True" AcceptsReturn="True" MaxHeight="180" TextWrapping="Wrap" />
  </Grid>
</Window>
