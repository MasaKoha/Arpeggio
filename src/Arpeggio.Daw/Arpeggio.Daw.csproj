<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>arpeggio-daw</AssemblyName>
    <RootNamespace>Arpeggio.Daw</RootNamespace>
    <LangVersion>14</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\arpeggio.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <AvalonProjectPath>$(MSBuildThisFileDirectory)../../../Avalon/src/Avalon/Avalon.csproj</AvalonProjectPath>
  </PropertyGroup>

  <!-- 配布物へ操作サーバーを含めず、隣接リポジトリがない環境でも通常のビルドを維持する。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And Exists('$(AvalonProjectPath)')">
    <DefineConstants>$(DefineConstants);AVALON</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' And Exists('$(AvalonProjectPath)')">
    <ProjectReference Include="$(AvalonProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\examples\snes-demo.arpeggio.json" Link="Examples\snes-demo.arpeggio.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.12.4" ExcludeAssets="analyzers" />
    <PackageReference Include="SDL3-CS.Native" Version="3.4.2" ExcludeAssets="analyzers" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arpeggio.Codecs\Arpeggio.Codecs.csproj" />
    <ProjectReference Include="..\Arpeggio.Core\Arpeggio.Core.csproj" />
    <ProjectReference Include="..\Arpeggio.Formats\Arpeggio.Formats.csproj" />
  </ItemGroup>

  <!-- SDL3-CS 3.4.16 のソースジェネレーターは SDK 10.0.300 の Roslyn より新しいコンパイラを要求するため除外する。バインディング本体は lib の DLL に含まれる -->
  <Target Name="RemoveSdl3Generators" AfterTargets="ResolvePackageAssets;ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'SDL3-CS.Generators'" />
    </ItemGroup>
  </Target>

</Project>
